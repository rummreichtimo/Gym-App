// IronPath database schema
// Provider: PostgreSQL, in local development and in production alike, so the
// two never diverge. Every model that holds user content carries a userId FK
// so queries can always be scoped to the authenticated user
// (see src/server/auth.ts + src/server/api.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Account & profile
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          Profile?
  sessions         Session[]
  resetTokens      PasswordResetToken[]
  plans            WorkoutPlan[]
  exercises        Exercise[]
  workoutSessions  WorkoutSession[]
  personalRecords  PersonalRecord[]
  foods            Food[]
  meals            Meal[]
  savedMeals       SavedMeal[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  goals            Goal[]
  notifications    Notification[]
  reminders        Reminder[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Everything user-configurable that is not credentials.
model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  avatarUrl     String?
  birthDate     DateTime?
  heightCm      Float?
  startWeightKg Float?
  gender        String? // male | female | other | undisclosed
  goal          String    @default("muscle_gain") // muscle_gain | fat_loss | maintain | strength | fitness
  activityLevel String    @default("moderate") // sedentary | light | moderate | active | very_active
  experience    String    @default("intermediate") // beginner | intermediate | advanced
  weeklyTarget  Int       @default(4) // planned workouts per week

  // Units & locale
  weightUnit String @default("kg") // kg | lb
  lengthUnit String @default("cm") // cm | in
  language   String @default("de") // de | en
  theme      String @default("dark") // dark | light | system

  // Nutrition targets
  calorieTarget Int @default(2400)
  proteinTarget Int @default(160)
  carbTarget    Int @default(280)
  fatTarget     Int @default(80)

  // Behaviour
  defaultRestSec      Int     @default(120)
  soundEnabled        Boolean @default(true)
  notificationsOn     Boolean @default(true)
  activePlanId        String?
  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Exercises
// ---------------------------------------------------------------------------

/// Exercises with userId == null are the shared, seeded library (read-only).
/// Exercises with a userId belong to that user only.
model Exercise {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name             String
  muscleGroup      String // primary muscle group key
  secondaryMuscles String   @default("") // comma separated keys
  equipment        String
  difficulty       String   @default("intermediate") // beginner | intermediate | advanced
  description      String   @default("")
  instructions     String   @default("") // newline separated steps
  isCustom         Boolean  @default(false)
  createdAt        DateTime @default(now())

  planExercises    PlanExercise[]
  sessionExercises SessionExercise[]
  personalRecords  PersonalRecord[]
  goals            Goal[]

  @@index([userId])
  @@index([muscleGroup])
}

// ---------------------------------------------------------------------------
// Training plans
// ---------------------------------------------------------------------------

model WorkoutPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  days     WorkoutDay[]
  sessions WorkoutSession[]

  @@index([userId])
}

model WorkoutDay {
  id      String      @id @default(cuid())
  planId  String
  plan    WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name    String
  notes   String      @default("")
  order   Int         @default(0)
  /// 0 = Sunday ... 6 = Saturday. null = flexible / not bound to a weekday.
  weekday Int?

  exercises PlanExercise[]
  sessions  WorkoutSession[]

  @@index([planId])
}

model PlanExercise {
  id           String     @id @default(cuid())
  dayId        String
  day          WorkoutDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order        Int        @default(0)
  targetSets   Int        @default(3)
  repMin       Int        @default(8)
  repMax       Int        @default(12)
  targetWeight Float?
  restSec      Int        @default(120)
  notes        String     @default("")

  @@index([dayId])
  @@index([exerciseId])
}

// ---------------------------------------------------------------------------
// Workout sessions (actually performed training)
// ---------------------------------------------------------------------------

model WorkoutSession {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String?
  plan   WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  dayId  String?
  day    WorkoutDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)

  name        String
  status      String    @default("active") // active | completed
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  durationSec Int       @default(0)
  totalVolume Float     @default(0)
  notes       String    @default("")

  exercises       SessionExercise[]
  personalRecords PersonalRecord[]

  @@index([userId, startedAt])
  @@index([userId, status])
}

model SessionExercise {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order      Int            @default(0)
  restSec    Int            @default(120)
  notes      String         @default("")

  sets ExerciseSet[]

  @@index([sessionId])
  @@index([exerciseId])
}

model ExerciseSet {
  id                String          @id @default(cuid())
  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weightKg          Float           @default(0)
  reps              Int             @default(0)
  rir               Int?
  rpe               Float?
  isWarmup          Boolean         @default(false)
  completed         Boolean         @default(false)
  notes             String          @default("")
  createdAt         DateTime        @default(now())

  @@index([sessionExerciseId])
}

model PersonalRecord {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  /// max_weight | max_reps | est_1rm | max_volume
  type       String
  value      Float
  weightKg   Float?
  reps       Int?
  achievedAt DateTime @default(now())

  @@index([userId, exerciseId, type])
}

// ---------------------------------------------------------------------------
// Nutrition
// ---------------------------------------------------------------------------

/// Foods with userId == null are the shared seeded database.
model Food {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  brand       String   @default("")
  /// Nutrition values always refer to `servingSize` of `servingUnit`.
  servingSize Float    @default(100)
  servingUnit String   @default("g") // g | ml | piece | portion
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  category    String   @default("other")
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())

  mealItems      MealItem[]
  savedMealItems SavedMealItem[]

  @@index([userId])
  @@index([name])
}

model Meal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar day in YYYY-MM-DD form so day queries never depend on TZ.
  date      String
  name      String // Frühstück | Mittagessen | Abendessen | Snacks | custom
  order     Int      @default(0)
  createdAt DateTime @default(now())

  items MealItem[]

  @@index([userId, date])
}

model MealItem {
  id     String  @id @default(cuid())
  mealId String
  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId String?
  food   Food?   @relation(fields: [foodId], references: [id], onDelete: SetNull)

  /// Snapshot of the food at logging time - keeps history correct even if the
  /// underlying food is later edited or deleted.
  name      String
  amount    Float // in `unit`
  unit      String   @default("g")
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  createdAt DateTime @default(now())

  @@index([mealId])
}

/// A reusable meal template ("Mahlzeit speichern").
model SavedMeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  items SavedMealItem[]

  @@index([userId])
}

model SavedMealItem {
  id          String    @id @default(cuid())
  savedMealId String
  savedMeal   SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodId      String?
  food        Food?     @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name        String
  amount      Float
  unit        String    @default("g")
  calories    Float
  protein     Float
  carbs       Float
  fat         Float

  @@index([savedMealId])
}

// ---------------------------------------------------------------------------
// Body tracking & goals
// ---------------------------------------------------------------------------

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  weightKg  Float?
  bodyFat   Float?
  chestCm   Float?
  waistCm   Float?
  hipCm     Float?
  armCm     Float?
  thighCm   Float?
  calfCm    Float?
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  /// Data URL or /uploads path. Kept small (client-side downscaled).
  imageData String
  pose      String   @default("front") // front | side | back
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  /// exercise_1rm | exercise_weight | bodyweight | workouts_per_week |
  /// weekly_volume | daily_calories | daily_protein | custom
  type         String
  exerciseId   String?
  exercise     Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  startValue   Float     @default(0)
  targetValue  Float
  currentValue Float     @default(0)
  unit         String    @default("")
  /// "increase" goals grow toward the target, "decrease" goals shrink to it.
  direction    String    @default("increase")
  deadline     DateTime?
  status       String    @default("active") // active | achieved | archived
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Notifications & reminders
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // pr | streak | reminder | goal | system | rest
  title     String
  body      String    @default("")
  icon      String    @default("bell")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  /// De-duplication key so generated notifications are not re-created.
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // workout | weigh_in | meal | protein
  title     String
  /// HH:MM local time
  time      String   @default("18:00")
  /// Comma separated weekdays 0-6, empty = every day
  weekdays  String   @default("")
  enabled   Boolean  @default(true)
  lastFired String? // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@index([userId])
}
