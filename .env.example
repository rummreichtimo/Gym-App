# --- Datenbank --------------------------------------------------------------
# Passt zu `docker compose up -d` aus diesem Repo.
# Beim Deployment gibt dir der Anbieter (Neon, Supabase, …) zwei Strings:
#   DATABASE_URL -> der gepoolte  (enthält meist "-pooler"), nutzt die App
#   DIRECT_URL   -> der direkte,  den brauchen die Migrationen
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ironpath"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ironpath"

# --- Sicherheit -------------------------------------------------------------
# Signiert die Session-Cookies. MUSS in Produktion ein langer Zufallswert sein.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# --- E-Mail (optional) ------------------------------------------------------
# Ist ein Versandweg konfiguriert, muss jede neue Registrierung per Code
# bestätigt werden. Fehlt er, funktioniert die App weiterhin, nur ohne
# Bestätigung - so sperrt eine unvollständige Konfiguration niemanden aus.
#
# EMAIL_FROM ist immer nötig, dazu EINER der beiden Wege darunter.
EMAIL_FROM="IronPath <deine-adresse@gmail.com>"

# Weg A - SMTP über ein vorhandenes Postfach.
# Erreicht JEDE Empfängeradresse, ohne eigene Domain.
# Gmail:  smtp.gmail.com : 587   (App-Passwort nötig, nicht das normale)
# GMX:    mail.gmx.net    : 587
# Web.de: smtp.web.de     : 587
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Weg B - Resend über HTTP (https://resend.com/api-keys).
# Erreicht fremde Adressen erst, wenn bei Resend eine Domain verifiziert ist.
# Wird ignoriert, sobald Weg A konfiguriert ist.
RESEND_API_KEY=""

# Diese Adresse bekommt bei jeder neuen Registrierung eine Benachrichtigung.
ADMIN_EMAIL=""
