# PostgreSQL. Passt zu `docker compose up -d` aus diesem Repo.
# Für ein Deployment die URL des gehosteten Anbieters eintragen
# (Neon, Supabase, Vercel Postgres, Railway …).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ironpath"

# Signiert die Session-Cookies. MUSS in Produktion ein langer Zufallswert sein.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
